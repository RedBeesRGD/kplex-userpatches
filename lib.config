# The kplex kernel branch: linux-kplex at a pinned commit. Scoped to BRANCH=kplex so any other
# build from this tree gets Armbian's own kernel.
if [[ "${BRANCH}" == "kplex" ]]; then
	KERNELSOURCE='https://github.com/RedBeesRGD/linux-kplex.git'
	KERNELBRANCH='commit:bb2bb296b6ed538415d8f87fc1f1c9f4b65ad168'
	KERNEL_MAJOR_MINOR="6.1"
	KERNELPATCHDIR='rk35xx-vendor-6.1'
	BOOTDIR='u-boot-rockchip64'
fi
